{
  "name": "ibmi-agentic",
  "description": "IBM i agentic coding test environment",
  "image_name": "ibmi-development",
  "default_agent": "claude",
  "repos": [
    {
      "name": "ibmi-agentic",
      "url": "https://github.com/ProfoundLogic/ibmi-agentic.git",
      "branch": "main",
      "allow_branch_selection": true,
      "remote_provider": {
        "provider": "github-coderflow-demo-server",
        "credential_mode": "app"
      },
      "clone_auto": true,
      "description": "Example repo for traditional 5250 and RPGOA development"
    }
  ],
  "rebuild_schedule": {
    "enabled": true,
    "interval_hours": 24
  },
  "skills": [
    "code-comments-best-practices",
    "ibmi-program-documentation",
    "rpg-coderflow",
    "sql",
    "codermake",
    "ibmi-interactive-session",
    "ibmi-clcmd"
  ],
  "external_connections": [
    {
      "name": "dev",
      "type": "ibmi",
      "description": "IBM i Development Server",
      "available_for": [
        "tasks"
      ],
      "config": {
        "host": "idev.profoundlogic.com",
        "user": "aidemo",
        "features": [
          "sql",
          "build",
          "interactive",
          "ssh",
          "sync"
        ],
        "sync_credentials": "prompt",
        "pui_base_url": "https://idev.profoundlogic.com:8103",
        "build_repo": "ibmi-agentic",
        "build_library_prefix": "AITSK"
      },
      "id": "44e3d948-61a6-4782-84d4-c94586b5757d"
    }
  ],
  "application_server": {
    "launch_urls": [
      {
        "name": "Genie (5250 Skin)",
        "path": "/profoundui/auth/genie?skin=classic",
        "description": "Genie w/Classic Skin"
      }
    ],
    "enabled": true,
    "name": "",
    "qa_url": "https://idev.profoundlogic.com:8103"
  },
  "standardInstructions": {
    "outputRequirements": true,
    "screenshotGuidelines": false,
    "ibmiOutputRequirements": true,
    "ibmiExploratoryVerification": true,
    "ibmiDatabaseSql": true
  }
}