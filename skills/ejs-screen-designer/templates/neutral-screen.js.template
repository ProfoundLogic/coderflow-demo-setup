/* Neutral starter JS.
   - F3 keyboard shortcut → action 'EXIT'.
   - Enter on toolbar inputs → action 'SEARCH'.
   - Row click → set SOPT='5' for that RRN, submit action 'OK'.
     Per references/pui-submit-contract.md, this passes the override map AND
     mutates the hidden input — both are required for reliability.
   - Sortable table columns (data-sort-key/data-sort-type on header buttons).
*/

(function () {

  function $(sel, root) { return (root || document).querySelector(sel); }
  function $$(sel, root) { return Array.from((root || document).querySelectorAll(sel)); }

  /* ---------- F3 → EXIT ---------- */

  function wireFunctionKeys() {
    document.addEventListener("keydown", function (event) {
      if (event.key === "F3") {
        event.preventDefault();
        if (window.pui && typeof window.pui.submit === "function") {
          window.pui.submit({ action: "EXIT" });
        }
      }
    });
  }

  /* ---------- Enter on toolbar inputs → SEARCH ---------- */

  function wireEnterSubmit() {
    $$(".toolbar .input").forEach(function (input) {
      input.addEventListener("keydown", function (event) {
        if (event.key === "Enter" && window.pui && typeof window.pui.submit === "function") {
          event.preventDefault();
          window.pui.submit({ action: "SEARCH" });
        }
      });
    });
  }

  /* ---------- Row click → drilldown ---------- */

  function wireRowClick() {
    $$("tr.row[data-rrn]").forEach(function (row) {
      row.addEventListener("click", function (event) {
        if (event.target.closest("input, a, button")) return;
        var sel = window.getSelection && window.getSelection();
        if (sel && sel.toString().length > 0) return;

        var rrn = row.dataset.rrn;
        if (!rrn) return;
        if (!window.pui || typeof window.pui.submit !== "function") return;

        // Discover the subfile name from the hidden SOPT input on the row.
        var hidden = row.querySelector('input[type="hidden"][name$=".sopt." + rrn], input[type="hidden"][name*=".sopt."]');
        if (!hidden) return;
        // Pull the subfile name from input[name="custsfl.sopt.6"] -> "custsfl"
        var sflName = hidden.name.split(".sopt.")[0];

        var overrides = { action: "OK" };
        overrides[sflName + ".sopt." + rrn] = "5";
        hidden.value = "5";

        try {
          window.pui.submit(overrides);
        } catch (err) {
          window.pui.submit({ action: "OK" });
        }
      });
      row.style.cursor = "pointer";
    });
  }

  /* ---------- Sortable tables ---------- */

  function toDatasetKey(key) {
    return "sort" + key.charAt(0).toUpperCase() + key.slice(1);
  }
  function normalizeText(value) {
    return String(value || "").trim().toLowerCase();
  }
  function normalizeNumber(value) {
    var parsed = Number(String(value || "").replace(/,/g, ""));
    return isNaN(parsed) ? Number.NEGATIVE_INFINITY : parsed;
  }
  function updateSortState(buttons, activeButton, direction) {
    buttons.forEach(function (button) {
      var isActive = button === activeButton;
      button.classList.toggle("is-active", isActive);
      button.classList.toggle("asc",  isActive && direction === "asc");
      button.classList.toggle("desc", isActive && direction === "desc");
      button.setAttribute("aria-sort",
        isActive ? (direction === "asc" ? "ascending" : "descending") : "none");
    });
  }
  function sortRows(tbody, rows, key, type, direction) {
    var dataKey = toDatasetKey(key);
    var factor = direction === "asc" ? 1 : -1;
    var sorted = rows.slice().sort(function (a, b) {
      var av = a.element.dataset[dataKey];
      var bv = b.element.dataset[dataKey];
      var cmp = (type === "number")
        ? (normalizeNumber(av) - normalizeNumber(bv))
        : (normalizeText(av).localeCompare(normalizeText(bv)));
      if (cmp === 0) return a.index - b.index;
      return cmp * factor;
    });
    sorted.forEach(function (r) { tbody.appendChild(r.element); });
  }
  function initSortableTable(table) {
    var tbody = table.querySelector("tbody");
    var buttons = $$(".sort", table);
    if (!tbody || buttons.length === 0) return;
    var rows = $$("tr.row", tbody).map(function (row, index) {
      return { element: row, index: index };
    });
    buttons.forEach(function (button) {
      button.addEventListener("click", function () {
        var key  = button.dataset.sortKey;
        var type = button.dataset.sortType || "text";
        var direction = (button.classList.contains("is-active") &&
                         button.classList.contains("asc")) ? "desc" : "asc";
        sortRows(tbody, rows, key, type, direction);
        updateSortState(buttons, button, direction);
      });
    });
  }

  /* ---------- Init ---------- */

  function init() {
    wireFunctionKeys();
    wireEnterSubmit();
    wireRowClick();
    $$("[data-sortable-table]").forEach(initSortableTable);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }

}());
