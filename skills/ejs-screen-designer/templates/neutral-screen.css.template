/* ===========================================================
   Neutral (brand-agnostic) starter CSS.
   Structure only. No brand colors. The user re-skins after.
   =========================================================== */

:root {
  --c-primary:    #2563EB;
  --c-primary-deep: #1D4ED8;
  --c-bg:         #F8FAFC;
  --c-surface:    #FFFFFF;
  --c-line:       #E2E8F0;
  --c-line-deep:  #CBD5E1;
  --c-ink:        #0F172A;
  --c-ink-soft:   #475569;
  --c-amber:      #D97706;
  --c-green:      #16A34A;
  --c-red:        #DC2626;

  --radius:       4px;
  --radius-lg:    8px;
  --shadow-sm:    0 1px 0 rgba(15,23,42,0.04);
  --shadow-md:    0 6px 18px rgba(15,23,42,0.08);

  --font-sans:    -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  --font-mono:    "SF Mono", Menlo, Consolas, "Roboto Mono", monospace;
}

* { box-sizing: border-box; }

html, body {
  margin: 0;
  background: var(--c-bg);
  min-height: 100vh;
  font-family: var(--font-sans);
  color: var(--c-ink);
}

.screen {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  isolation: isolate;
}

/* Defensive page-bg layer — see ECWA UX standards § layout chassis */
.screen::before {
  content: "";
  position: fixed;
  inset: 0;
  background: var(--c-bg);
  z-index: -1;
  pointer-events: none;
}

/* ---------- Brand bar ---------- */

.brandbar {
  background: var(--c-primary);
  color: #fff;
  padding: 14px 28px;
}
.brandbar__inner {
  max-width: 1400px; margin: 0 auto;
  display: flex; align-items: center; justify-content: space-between;
  gap: 24px;
}
.brandbar__title { font-weight: 700; font-size: 18px; letter-spacing: 0.04em; }
.brandbar__nav { font-size: 12px; letter-spacing: 0.10em; text-transform: uppercase; opacity: 0.85; }
.brandbar__crumb--current { font-weight: 600; opacity: 1; }
.brandbar__sep { padding: 0 8px; opacity: 0.5; }

/* ---------- Main ---------- */

.main {
  flex: 1;
  max-width: 1400px;
  width: 100%;
  margin: 0 auto;
  padding: 28px 28px 80px;
}

.titlebar { margin-bottom: 16px; }
.title    { margin: 0; font-size: 28px; font-weight: 700; color: var(--c-ink); }

/* ---------- Card ---------- */

.card {
  background: var(--c-surface);
  border: 1px solid var(--c-line);
  border-radius: var(--radius-lg);
  padding: 20px 22px;
  box-shadow: var(--shadow-md);
  display: flex; flex-direction: column; gap: 14px;
  margin-bottom: 18px;
}
.card__head {
  display: flex; justify-content: space-between; align-items: center;
  border-bottom: 1px solid var(--c-line);
  padding-bottom: 10px;
}
.card__head h2 {
  margin: 0; font-size: 12px; font-weight: 700;
  letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--c-ink-soft);
}
.card--table { padding: 0; }
.card--table .table { border-radius: var(--radius-lg); overflow: hidden; }

/* ---------- Toolbar ---------- */

.toolbar {
  display: flex; gap: 12px; align-items: flex-end; flex-wrap: wrap;
  background: var(--c-surface);
  border: 1px solid var(--c-line);
  border-radius: var(--radius-lg);
  padding: 14px 16px;
  box-shadow: var(--shadow-sm);
  margin-bottom: 18px;
}

/* ---------- Inputs ---------- */

.input {
  padding: 8px 10px;
  border: 1px solid var(--c-line-deep);
  border-radius: var(--radius);
  font: inherit;
  background: #fff;
}
.input:focus {
  outline: none;
  border-color: var(--c-primary);
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.18);
}

/* ---------- Buttons ---------- */

.btn {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 9px 16px;
  border: 1px solid transparent; border-radius: var(--radius);
  font: inherit; font-size: 13px; font-weight: 600;
  cursor: pointer;
  transition: background 0.15s, color 0.15s, border-color 0.15s, transform 0.05s;
}
.btn:active { transform: translateY(1px); }
.btn--primary { background: var(--c-primary); color: #fff; border-color: var(--c-primary-deep); }
.btn--primary:hover { background: var(--c-primary-deep); }
.btn--ghost   { background: transparent; color: var(--c-ink); border-color: var(--c-line-deep); }
.btn--ghost:hover { background: var(--c-bg); border-color: var(--c-ink-soft); }

/* ---------- Alert ---------- */

.alert {
  padding: 10px 14px;
  border: 1px solid #FBA61F44;
  border-left: 3px solid var(--c-amber);
  background: #FFF7ED;
  color: #7C2D12;
  border-radius: var(--radius);
  font-size: 14px;
  margin-bottom: 14px;
}
.alert--error {
  border-left-color: var(--c-red);
  background: #FEF2F2;
  color: #991B1B;
  border-color: #FCA5A5;
}

/* ---------- Table ---------- */

.table { width: 100%; border-collapse: collapse; font-size: 14px; background: var(--c-surface); }
.table thead { background: #F1F5F9; }
.table th, .table td { padding: 10px 12px; text-align: left; }
.table th {
  border-bottom: 2px solid var(--c-line-deep);
  font-size: 11px; font-weight: 700;
  letter-spacing: 0.10em; text-transform: uppercase;
  color: var(--c-ink-soft);
}
.table tbody td { border-bottom: 1px solid var(--c-line); }
.table .row { transition: background 0.1s; }
.table .row:hover { background: #F8FAFC; cursor: pointer; }

/* Sort buttons */
.sort {
  background: none; border: 0; padding: 0;
  font: inherit; color: inherit; cursor: pointer;
  display: inline-flex; align-items: center; gap: 4px;
}
.sort.is-active { color: var(--c-primary); }

/* ---------- Empty state ---------- */

.empty {
  padding: 40px 20px;
  text-align: center;
  color: var(--c-ink-soft);
  font-size: 13px;
}

/* ---------- Action bar ---------- */

.actionbar {
  position: sticky;
  bottom: 0;
  z-index: 50;
  background: #1E293B;
  color: #E2E8F0;
  border-top: 3px solid var(--c-primary);
  margin-top: auto;
  box-shadow: 0 -8px 24px rgba(15, 23, 42, 0.18);
}
.actionbar__inner {
  max-width: 1400px;
  margin: 0 auto;
  padding: 12px 28px;
  display: flex;
  justify-content: flex-end;
  gap: 10px;
}
.actionbar .btn--ghost {
  color: #fff;
  border-color: rgba(255,255,255,0.25);
}
.actionbar .btn--ghost:hover {
  background: rgba(255,255,255,0.08);
  border-color: rgba(255,255,255,0.5);
}

/* ---------- Modal ---------- */

.modal-backdrop {
  position: fixed; inset: 0;
  background: rgba(15, 23, 42, 0.55);
  z-index: 80;
  display: flex; align-items: center; justify-content: center;
  padding: 24px;
}
.modal {
  background: #fff;
  border-radius: var(--radius-lg);
  box-shadow: 0 24px 48px rgba(15, 23, 42, 0.30);
  max-width: 640px; width: 100%;
  display: flex; flex-direction: column;
}
.modal__head {
  display: flex; justify-content: space-between; align-items: center;
  padding: 16px 22px;
  border-bottom: 1px solid var(--c-line);
}
.modal__head h2 { margin: 0; font-size: 16px; font-weight: 700; }
.modal__close {
  background: none; border: 0; font-size: 22px; line-height: 1;
  cursor: pointer; color: var(--c-ink-soft); padding: 0 4px;
}
.modal__body { padding: 20px 22px; overflow-y: auto; max-height: 60vh; }
.modal__foot {
  padding: 14px 22px;
  border-top: 1px solid var(--c-line);
  display: flex; gap: 10px; justify-content: flex-end;
}

/* ---------- Mono ---------- */

.mono { font-family: var(--font-mono); font-feature-settings: "tnum"; }

/* ---------- Reduced motion ---------- */

@media (prefers-reduced-motion: reduce) {
  * {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* ---------- Responsive ---------- */

@media (max-width: 800px) {
  .brandbar__nav { display: none; }
  .toolbar { flex-direction: column; align-items: stretch; }
  .toolbar .input { width: 100%; }
  .title { font-size: 22px; }
}
