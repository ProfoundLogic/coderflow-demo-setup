<div class="screen" data-screen="{{SCREEN}}">

  <header class="brandbar">
    <div class="brandbar__inner">
      <span class="brandbar__title">{{TITLE}}</span>
      <nav class="brandbar__nav" aria-label="Breadcrumb">
        <span class="brandbar__crumb">{{CRUMB1}}</span>
        <span class="brandbar__sep">/</span>
        <span class="brandbar__crumb brandbar__crumb--current">{{CRUMB2}}</span>
      </nav>
    </div>
  </header>

  <main class="main">

    <% if (typeof msg !== 'undefined' && msg && msg.trim()) { %>
      <div class="alert"><%= msg %></div>
    <% } %>

    <section class="card">
      <header class="card__head"><h2>{{SECTION_TITLE}}</h2></header>

      {{ FIELDS — render each surviving DSPF field here.
         Output fields:    <span class="value"><%= <fieldname> %></span>
         Input fields:     <input name="<fieldname>" value="<%= <fieldname> %>" class="input">
         Numeric mono:     <span class="value mono"><%= <fieldname> %></span>
         See references/pui-submit-contract.md for the action / hidden input contract. }}

    </section>

    <input type="hidden" name="action" value="">

  </main>

  <footer class="actionbar">
    <div class="actionbar__inner">
      <div class="actionbar__buttons">
        <button type="button" onclick="pui.submit({action: 'EXIT'})" data-fkey="F3" class="btn btn--ghost">Back</button>
      </div>
    </div>
  </footer>

</div>
